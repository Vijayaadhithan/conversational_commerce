OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=ministral-3:8b
DATABASE_PATH=data/conversations.sqlite3
# Shopping-only API: omitted conversation mode becomes commerce; explicit chat is disabled.
COMMERCE_ONLY=1
# One bounded evidence-selection call after retrieval; template fallback on failure.
COMMERCE_SUMMARY_ENABLED=1
# Separate PostgreSQL catalog; SQLite above continues to store conversations.
CATALOG_DATABASE_URL=postgresql:///conversational_commerce
# Qdrant is required for online retrieval and index publication.
# Durable, versioned embedding snapshots used for indexing and rebuilds.
SEARCH_ARTIFACT_DIR=data/search/embeddings
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=commerce
QDRANT_TIMEOUT_SECONDS=15
# Exact first; enable ANN only after measuring filtered recall and relevance.
QDRANT_EXACT=1
# Authoritative PostgreSQL eligibility is bounded; larger catalogs need a measured redesign.
QDRANT_MAX_ELIGIBLE=100000
CATALOG_ETL_OUTPUT_DIR=../conversational_commerce_etl/data/processed
# Original input for enrichment. Set CATALOG_ETL_OUTPUT_DIR to the enriched output after validation.
CATALOG_ENRICHMENT_SOURCE_DIR=../conversational_commerce_etl/data/processed
CATALOG_ENRICHMENT_OUTPUT_DIR=data/enriched_duckdb
# Optional bounded Redis search cache; empty means disabled.
SEARCH_CACHE_REDIS_URL=
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=128
# Load and probe embedding/reranking models before API startup completes.
SEARCH_WARMUP=0
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_MAX_TOKENS=1024
OLLAMA_KEEP_ALIVE=10m
RERANK_MODEL_PATH=models/mxbai-rerank-large-v2
RERANK_DEVICE=auto
RERANK_BATCH_SIZE=2
RERANK_MAX_LENGTH=512
PRODUCT_RERANK_CANDIDATES=20
SYSTEM_PROMPT=You are a helpful conversational assistant. Use the conversation history to maintain continuity. Be clear and practical. Ask for clarification when needed. Do not invent facts about the user.

# Authenticated, single-worker serving. Tokens are issued with manage_api_users.py.
API_AUTH_REQUIRED=1
API_REQUIRE_IDEMPOTENCY_KEY=1
# Terminal client reads this private token file; never commit its contents.
COMMERCE_API_TOKEN_FILE=data/credentials/local-user.token
API_REQUESTS_PER_MINUTE=120
API_REQUEST_BURST=30
API_MODEL_REQUESTS_PER_MINUTE=30
API_MODEL_BURST=8
API_MODEL_CONCURRENCY=1
API_MODEL_QUEUE_SIZE=8
API_MODEL_QUEUE_TIMEOUT_SECONDS=120
API_MONITOR_INTERVAL_SECONDS=30
API_ALERT_ERROR_RATIO=0.1
API_ALERT_LATENCY_SECONDS=60
API_ALERT_RSS_MB=8192
# Isolate evaluation runs from normal cached results. Keep v1 for normal serving.
SEARCH_CACHE_NAMESPACE=v1

# Independent providers: local development defaults remain available.
# LLM_PROVIDER: ollama | google | groq | openrouter
LLM_PROVIDER=ollama
# Required for hosted LLMs: exact provider model ID (OpenRouter uses vendor/model).
LLM_MODEL=
# Empty values inherit the OLLAMA_* limits above for compatibility.
LLM_TIMEOUT_SECONDS=
LLM_CONTEXT_SIZE=
LLM_MAX_TOKENS=
# EMBEDDING_PROVIDER: ollama | google. Switching requires a search index rebuild.
EMBEDDING_PROVIDER=ollama
# Native Google retrieval tasks, normalized 768-dimensional vectors.
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# Increment and rebuild if the hosted model changes behind the same model ID.
EMBEDDING_REVISION=1
# RERANK_PROVIDER: local | voyage
RERANK_PROVIDER=local
VOYAGE_RERANK_MODEL=rerank-2.5
RERANK_TIMEOUT_SECONDS=60
# Secrets: set either KEY or KEY_FILE per provider, never both.
# Prefer mounted secret files in production. Never commit actual credentials.
GOOGLE_API_KEY=
GOOGLE_API_KEY_FILE=
GROQ_API_KEY=
GROQ_API_KEY_FILE=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
VOYAGE_API_KEY=
VOYAGE_API_KEY_FILE=
